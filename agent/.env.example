# MedGraph Agent Environment Configuration Template

API_BASE_URL=http://localhost:5000
GRAPH_SEARCH_ENDPOINT=/api/graph/search
VECTOR_SEARCH_ENDPOINT=/api/vector/search
ADMISSION_ENDPOINT=/api/patients/{patient_id}/admissions

USE_MOCK_API=False
RETRIEVAL_MODE=external_api

# Primary LLM Provider ("sarvam" | "nvidia" | "openai" | "mock")
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_BASE_URL=https://api.sarvam.ai/v2

# Fallback LLM Provider (NVIDIA)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

TEMPERATURE=0.1
MAX_RETRIES=2
LOG_LEVEL=INFO
