# ==========================================
# MedGraph Environment Configuration
# ==========================================

# Main Express Backend API Endpoints
API_BASE_URL=http://localhost:3000
GRAPH_SEARCH_ENDPOINT=/api/graph/search
VECTOR_SEARCH_ENDPOINT=/api/vector/search
ADMISSION_ENDPOINT=/api/patients/{patient_id}/admissions

# Set to True during development/testing or when backend API is offline
USE_MOCK_API=True

# LLM Provider Configuration ("mock" | "openai" | "google_genai" | "anthropic")
# If set to "mock", MedGraph uses a deterministic clinical reasoning engine without requiring API keys.
LLM_PROVIDER=mock
TEMPERATURE=0.0

# Optional Provider API Keys and Model Names
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Workflow Controls
MAX_RETRIES=2
LOG_LEVEL=INFO
