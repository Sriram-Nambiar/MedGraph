# MedGraph Backend Environment Configuration Template

PORT=5000
NODE_ENV=development

# Primary LLM Provider ("sarvam" | "nvidia" | "openai" | "mock")
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
USE_IN_MEMORY_FALLBACK=true

# Vector Retrieval & Embeddings
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# Fallback LLM Provider (NVIDIA)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# LangGraph AI Agent Service
AGENT_SERVICE_URL=http://localhost:8000/investigate
